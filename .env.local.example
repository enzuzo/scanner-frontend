# URL of the scanner-proxy service (server-side only, not exposed to the browser)
# In Cloud Run, set these as environment variables on the service
PROXY_URL=http://localhost:3000
PROXY_TOKEN=your-token-here

# Google OAuth (see auth.ts) — required for `next dev` unless LOCAL_AUTH_BYPASS
# is set below.
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Local-only escape hatch: skips the Google OAuth gate entirely so you can run
# `next dev` against a real backend (e.g. staging) without any auth creds.
# Never takes effect in a production build/start (see app/lib/auth-bypass.js).
# LOCAL_AUTH_BYPASS=true

# Ops-only knob, not exposed anywhere in the UI: scanner-proxy's browser driver
# (Playwright vs the experimental patchright fork — scanner-proxy#57). Omit or
# set to anything other than "patchright" to use the default (Playwright).
# See app/lib/browser-driver.js.
# SCANNER_BROWSER_DRIVER=patchright
